{
  "name": "nfse-nacional",
  "version": "0.2.0",
  "description": "Cliente Node.js para a NFS-e Nacional (Sefin Nacional / ADN): emissão de DPS, recuperação idempotente, consulta, cancelamento e DANFSe (PDF) local com assinatura digital por certificado A1.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nfse",
    "nfse-nacional",
    "dps",
    "danfse",
    "sefin",
    "nota-fiscal",
    "nota-fiscal-servico",
    "simples-nacional",
    "certificado-a1",
    "xml-dsig"
  ],
  "author": "Marcio de Souza <marcio.ti.souza@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marciotisouza/nfse-nacional.git"
  },
  "bugs": {
    "url": "https://github.com/marciotisouza/nfse-nacional/issues"
  },
  "homepage": "https://github.com/marciotisouza/nfse-nacional#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "fast-xml-parser": "^5.2.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.0.1"
  },
  "peerDependencies": {
    "puppeteer": ">=10"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.3"
  }
}
